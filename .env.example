# Copie para .env e preencha:  cp .env.example .env
# NUNCA commite o .env (contém o access_token da Admin API). Ver .gitignore.

# --- Admin API (OAuth) ---
# Gerados por scripts/get-token.py a partir do code do OAuth (ver README, passo 2).
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_STORE_ID=

# --- Instalações de tema (nuvemshop theme list) ---
# Cada ambiente é uma instalação diferente na mesma loja. Limite da plataforma: 2 por loja.
THEME_ID_HOMOLOG=
THEME_ID_PROD=

# --- Opcionais (têm default no código; descomente só se precisar sobrescrever) ---
# TIENDANUBE_BASE_URL=https://api.nuvemshop.com.br/2025-03
# TIENDANUBE_USER_AGENT=cpapfit-nuvem (guilherme.borzoni@quickdigital.com.br)
# THEME_DIR=./theme

# Token da CLI para push/diff sem theme/.nuvem local (ex.: fora do container).
# Em dev normal use `nuvemshop theme authorize` (gera theme/.nuvem) e deixe vazio.
# Gerar: scripts/cli-token.sh
# NUVEMSHOP_CLI_TOKEN=
