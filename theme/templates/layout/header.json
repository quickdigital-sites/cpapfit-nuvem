{
  "type": "header",
  "name": "Cabeçalho",
  "sections": {
    "navigation_bar": {
      "type": "navigation-bar",
      "settings": {
        "section_width": "page",
        "horizontal_padding": 32,
        "background_color": "#2F3295",
        "text_color": "#FEFDFC",
        "vertical_padding": 10
      },
      "blocks": {
        "nav_icon_text": {
          "type": "nav-icon-text-group",
          "settings": {
            "alignment": "center",
            "gap": 24
          },
          "blocks": {
            "item_1": {
              "type": "nav-icon-text-item",
              "settings": {
                "icon_source": "design",
                "icon": "qd-pix",
                "description": "<strong>10% off</strong> no pix"
              }
            },
            "item_2": {
              "type": "nav-icon-text-item",
              "settings": {
                "icon_source": "design",
                "icon": "qd-card",
                "description": "<strong>12x sem juros</strong> no cartão de crédito"
              }
            },
            "item_3": {
              "type": "nav-icon-text-item",
              "settings": {
                "icon_source": "design",
                "icon": "qd-box",
                "description": "<strong>Frete grátis</strong>",
                "link": "/politica-de-entrega/",
                "link_label": "ver regras"
              }
            },
            "item_4": {
              "type": "nav-icon-text-item",
              "settings": {
                "icon_source": "design",
                "icon": "qd-tag",
                "description": "<strong>R$ 100 off</strong> na linha Philips",
                "coupon_code": "QUERO100"
              }
            }
          },
          "block_order": [
            "item_1",
            "item_2",
            "item_3",
            "item_4"
          ]
        }
      },
      "block_order": [
        "nav_icon_text"
      ]
    },
    "header": {
      "type": "header",
      "settings": {
        "logo_position_desktop": "left",
        "section_width": "page",
        "vertical_padding": 12,
        "horizontal_padding": 40,
        "use_different_mobile_padding": true,
        "vertical_padding_mobile": 16,
        "horizontal_padding_mobile": 28,
        "background_color": "#FFFFFF",
        "text_color": "#000066"
      },
      "blocks": {
        "logo": {
          "type": "header-logo",
          "settings": {
            "height": 74,
            "use_different_mobile_height": true,
            "height_mobile": 48
          }
        },
        "utilities": {
          "type": "header-utilities",
          "settings": {
            "format": "icons",
            "search_type": "icon",
            "cart_icon": "cart",
            "show_languages_header": false,
            "plans_title": "Planos de assinatura",
            "plans_subtitle": "Descontos e benefícios exclusivos!",
            "plans_url": "/planos-de-assinatura/",
            "stores_url": "/nossas-lojas/"
          }
        },
        "navigation": {
          "type": "header-navigation",
          "settings": {
            "nav_uppercase": false,
            "show_categories_link": false,
            "show_mobile_categories": false,
            "nav_alignment_desktop": "left",
            "vertical_padding": 14,
            "nav_divider_color": "transparent",
            "show_secondary_menu": false,
            "show_featured_link": true,
            "featured_link_item": "Contato",
            "featured_link_color": "#fb4516",
            "menu": "submenu"
          },
          "blocks": [],
          "block_order": []
        }
      },
      "block_order": [
        "logo",
        "utilities",
        "navigation"
      ]
    }
  },
  "order": [
    "header",
    "navigation_bar"
  ]
}