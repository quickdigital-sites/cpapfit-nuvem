{
  "sections": {
    "main_product": {
      "type": "main-product",
      "settings": {
        "section_width": "page",
        "column_gap": 16,
        "vertical_padding": 16,
        "horizontal_padding": 0,
        "background_color": "#FEFDFC"
      },
      "blocks": {
        "product_media": {
          "type": "product-media",
          "settings": {
            "show_thumbnails": true,
            "thumbnail_position": "left",
            "format": "slider",
            "columns": "1",
            "gap": 6
          }
        },
        "product_info": {
          "type": "product-info",
          "settings": {
            "gap": 20,
            "vertical_padding": 0,
            "horizontal_padding": 0
          },
          "blocks": {
            "description": {
              "type": "description",
              "settings": {
                "show_title": true,
                "show_social": false
              }
            },
            "purchase_info": {
              "type": "purchase-info",
              "settings": {
                "icon_size": 24,
                "title_size": "paragraph_small",
                "description_size": "paragraph_small",
                "gap": 10
              },
              "blocks": {
                "icon_returns": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "returns",
                    "title": "Seu título aqui",
                    "description": "Seu texto aqui"
                  }
                },
                "icon_security": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "security",
                    "title": "Garantia de 3 meses",
                    "description": "<a href=\"/troca-devolucao-garantia/\">ver regras</a>"
                  }
                }
              },
              "block_order": [
                "icon_security"
              ]
            }
          },
          "block_order": [
            "purchase_info",
            "description"
          ]
        }
      },
      "block_order": [
        "product_media",
        "product_info"
      ]
    },
    "complementary_products": {
      "type": "related-products",
      "settings": {
        "products_source": "complementary",
        "section_width": "page",
        "gap": 32,
        "vertical_padding": 0,
        "horizontal_padding": 0
      },
      "blocks": {
        "complementary_heading": {
          "type": "heading",
          "settings": {
            "title": "Compre junto",
            "size": "h4"
          }
        },
        "complementary_products_block": {
          "type": "product-recommendations",
          "settings": {
            "columns": "5",
            "columns_mobile": "2"
          }
        }
      },
      "block_order": [
        "complementary_heading",
        "complementary_products_block"
      ]
    },
    "alternative_products": {
      "type": "related-products",
      "settings": {
        "products_source": "alternative",
        "section_width": "page",
        "gap": 32,
        "vertical_padding": 0,
        "horizontal_padding": 0
      },
      "blocks": {
        "alternative_heading": {
          "type": "heading",
          "settings": {
            "title": "Veja também",
            "size": "h4"
          }
        },
        "alternative_products_block": {
          "type": "product-recommendations",
          "settings": {
            "columns": "5",
            "columns_mobile": "2"
          }
        }
      },
      "block_order": [
        "alternative_heading",
        "alternative_products_block"
      ]
    }
  },
  "order": [
    "main_product",
    "complementary_products",
    "alternative_products"
  ]
}
