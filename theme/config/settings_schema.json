[
  {
    "name": "Página de produto",
    "settings": [
      {
        "type": "paragraph",
        "content": "Opções da página de cada produto. Nome, fotos, preço e descrição são editados em Produtos, no painel da loja."
      },
      {
        "type": "header",
        "content": "Cupom em destaque"
      },
      {
        "type": "setting",
        "setting_type": "text",
        "id": "qd_pdp_coupon_text",
        "label": "Texto do cupom",
        "default": "R$ 100 OFF na linha Philips",
        "info": "Aparece ao lado do preço, em \"Aproveite também\". Ex.: R$ 100 OFF na linha Philips."
      },
      {
        "type": "setting",
        "setting_type": "text",
        "id": "qd_pdp_coupon_code",
        "label": "Código do cupom",
        "default": "QUERO100",
        "info": "O cliente copia este código com um clique. Deixe vazio para esconder o bloco do cupom."
      },
      {
        "type": "setting",
        "setting_type": "text",
        "id": "qd_pdp_coupon_brand",
        "label": "Mostrar o cupom só para a marca",
        "default": "Philips",
        "info": "Compara com o campo Marca do produto (ex.: Philips vale para \"Philips Respironics\"). Vazio: o cupom aparece em todos os produtos."
      },
      {
        "type": "header",
        "content": "Selo de garantia"
      },
      {
        "type": "setting",
        "setting_type": "text",
        "id": "qd_pdp_warranty_hide_categories",
        "label": "Não mostrar o selo de garantia nestas categorias",
        "default": "cpap-e-bipap",
        "info": "Endereço da categoria (ex.: cpap-e-bipap), separados por vírgula. Vale também para as subcategorias. O selo é o item \"Garantia…\" da página de produto (Personalizar › Produto)."
      },
      {
        "type": "header",
        "content": "Preço"
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "payment_discount_price",
        "label": "Mostrar o preço com desconto no Pix",
        "default": true,
        "info": "Só aparece se houver desconto para Pix configurado em Pagamentos, no painel da loja."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "product_detail_installments",
        "label": "Mostrar as parcelas",
        "default": true,
        "info": "Ex.: 12 x de R$ 37,43 sem juros, abaixo do preço."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "compare_price_saved_money",
        "label": "Mostrar quanto o cliente economiza",
        "default": true,
        "info": "Aparece quando o produto tem preço promocional."
      },
      {
        "type": "header",
        "content": "Informações"
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "product_sku",
        "label": "Mostrar o código do produto (SKU)",
        "default": false,
        "info": "Aparece abaixo do nome do produto."
      },
      {
        "type": "setting",
        "setting_type": "url",
        "id": "size_guide_url",
        "label": "Link da tabela de medidas",
        "info": "Página com as medidas das máscaras. Vazio: o link não aparece."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "shipping_calculator_product_page",
        "label": "Mostrar a calculadora de frete",
        "default": true,
        "info": "Campo de CEP na página do produto."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "products_sold",
        "label": "Mostrar quantas unidades já foram vendidas",
        "default": true
      },
      {
        "type": "setting",
        "setting_type": "number",
        "id": "quantity_products_sold",
        "label": "Mostrar a partir de quantas vendas",
        "default": 10,
        "visible_if": "{{ settings.products_sold }}",
        "info": "Abaixo deste número a informação fica escondida."
      },
      {
        "type": "header",
        "content": "Estoque"
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "product_stock",
        "label": "Mostrar a quantidade em estoque",
        "default": false
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "last_product",
        "label": "Avisar quando restarem poucas unidades",
        "default": true
      },
      {
        "type": "setting",
        "setting_type": "number",
        "id": "latest_products_available",
        "label": "Avisar a partir de quantas unidades",
        "default": 5,
        "visible_if": "{{ settings.last_product }}",
        "info": "Ex.: 5 mostra o aviso quando restarem 5 ou menos."
      },
      {
        "type": "setting",
        "setting_type": "text",
        "id": "last_product_text",
        "label": "Texto do aviso de poucas unidades",
        "default": "t:defaults.last_product_text",
        "visible_if": "{{ settings.last_product }}",
        "info": "Vazio: usa o texto padrão (\"Restam apenas X em estoque\")."
      }
    ]
  },
  {
    "name": "Vitrines de produtos",
    "settings": [
      {
        "type": "paragraph",
        "content": "Cartões de produto das vitrines da página inicial, das categorias e da busca."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "product_installments",
        "label": "Mostrar as parcelas no cartão",
        "default": true,
        "info": "Ex.: 12 x de R$ 37,43 sem juros."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "last_product_category",
        "label": "Avisar \"Última peça!\" quando restar 1 unidade",
        "default": true
      },
      {
        "type": "setting",
        "setting_type": "number",
        "id": "qd_pix_discount",
        "label": "Desconto no Pix mostrado nos cards (%)",
        "default": 10,
        "info": "Use o mesmo percentual configurado no Pix em Configurações › Meios de pagamento. O cartão mostra \"R$ X com Pix\" acima do preço cheio. 0 esconde. Na página do produto o valor vem direto do meio de pagamento."
      }
    ]
  },
  {
    "name": "Carrinho",
    "settings": [
      {
        "type": "setting",
        "setting_type": "number",
        "id": "cart_minimum_value",
        "label": "Valor mínimo da compra",
        "info": "Pedidos abaixo deste valor não podem seguir para o pagamento. Vazio: sem mínimo."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "cart_coupon",
        "label": "Mostrar o campo de cupom no carrinho",
        "default": false
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "shipping_calculator_cart_page",
        "label": "Mostrar a calculadora de frete no carrinho",
        "default": true
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "add_to_cart_recommendations",
        "label": "Sugerir outros produtos ao comprar",
        "default": true,
        "visible_if": "{{ settings.ajax_cart }}",
        "info": "Depois de adicionar um produto, mostra produtos relacionados."
      }
    ]
  },
  {
    "name": "Pop-up promocional",
    "settings": [
      {
        "type": "paragraph",
        "content": "Janela que aparece quando o cliente entra na loja. Use para campanhas e para o cadastro de e-mails."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "promotional_popup_enabled",
        "label": "Mostrar o pop-up",
        "default": false
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "promotional_popup_newsletter",
        "label": "Incluir o cadastro de e-mail no pop-up",
        "default": true,
        "visible_if": "{{ settings.promotional_popup_enabled }}"
      },
      {
        "type": "header",
        "content": "Imagem"
      },
      {
        "type": "setting",
        "setting_type": "image_picker",
        "id": "promotional_popup_image",
        "visible_if": "{{ settings.promotional_popup_enabled }}",
        "label": "Imagem",
        "info": "Recomendado: 800 × 800 px, JPG ou WebP."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "promotional_popup_use_mobile_image",
        "label": "Usar outra imagem no celular",
        "default": false,
        "visible_if": "{{ settings.promotional_popup_enabled }}"
      },
      {
        "type": "setting",
        "setting_type": "image_picker",
        "id": "promotional_popup_image_mobile",
        "label": "Imagem para celular",
        "visible_if": "{{ settings.promotional_popup_enabled and settings.promotional_popup_use_mobile_image }}",
        "info": "Recomendado: 700 × 500 px, JPG ou WebP."
      },
      {
        "type": "setting",
        "setting_type": "url",
        "id": "promotional_popup_url",
        "label": "Link da imagem",
        "visible_if": "{{ settings.promotional_popup_enabled }}",
        "info": "Página aberta ao clicar na imagem."
      },
      {
        "type": "header",
        "content": "Textos"
      },
      {
        "type": "setting",
        "setting_type": "inline_richtext",
        "id": "promotional_popup_title",
        "default": "t:defaults.newsletter.heading",
        "visible_if": "{{ settings.promotional_popup_enabled }}",
        "label": "Título"
      },
      {
        "type": "setting",
        "setting_type": "heading_select",
        "id": "promotional_popup_title_style",
        "label": "Tamanho do título",
        "options": [
          {
            "value": "h1",
            "label": "t:options.heading_1"
          },
          {
            "value": "h2",
            "label": "t:options.heading_2"
          },
          {
            "value": "h3",
            "label": "t:options.heading_3"
          },
          {
            "value": "h4",
            "label": "t:options.heading_4"
          },
          {
            "value": "h5",
            "label": "t:options.heading_5"
          },
          {
            "value": "h6",
            "label": "t:options.heading_6"
          }
        ],
        "default": "h4",
        "visible_if": "{{ settings.promotional_popup_enabled }}"
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "promotional_popup_title_mobile_style",
        "label": "Outro tamanho de título no celular",
        "default": false,
        "visible_if": "{{ settings.promotional_popup_enabled }}"
      },
      {
        "type": "setting",
        "setting_type": "heading_select",
        "id": "promotional_popup_title_style_mobile",
        "label": "Tamanho do título no celular",
        "options": [
          {
            "value": "h1",
            "label": "t:options.heading_1"
          },
          {
            "value": "h2",
            "label": "t:options.heading_2"
          },
          {
            "value": "h3",
            "label": "t:options.heading_3"
          },
          {
            "value": "h4",
            "label": "t:options.heading_4"
          },
          {
            "value": "h5",
            "label": "t:options.heading_5"
          },
          {
            "value": "h6",
            "label": "t:options.heading_6"
          }
        ],
        "default": "h3",
        "visible_if": "{{ settings.promotional_popup_enabled and settings.promotional_popup_title_mobile_style }}"
      },
      {
        "type": "setting",
        "setting_type": "richtext",
        "id": "promotional_popup_description",
        "default": "t:defaults.newsletter.description",
        "visible_if": "{{ settings.promotional_popup_enabled }}",
        "label": "Texto"
      },
      {
        "type": "setting",
        "setting_type": "select",
        "id": "promotional_popup_description_style",
        "label": "Tamanho do texto",
        "options": [
          {
            "value": "paragraph_small",
            "label": "t:options.paragraph_small"
          },
          {
            "value": "paragraph",
            "label": "t:options.paragraph"
          },
          {
            "value": "paragraph_big",
            "label": "t:options.paragraph_big"
          }
        ],
        "default": "paragraph",
        "visible_if": "{{ settings.promotional_popup_enabled }}"
      },
      {
        "type": "setting",
        "setting_type": "text",
        "id": "promotional_popup_button_text",
        "label": "Texto do botão",
        "default": "t:defaults.newsletter.button",
        "visible_if": "{{ settings.promotional_popup_enabled }}",
        "info": "Vazio: o botão não aparece."
      },
      {
        "type": "setting",
        "setting_type": "url",
        "id": "promotional_popup_button_link",
        "label": "Link do botão",
        "visible_if": "{{ settings.promotional_popup_enabled and not settings.promotional_popup_newsletter }}"
      },
      {
        "type": "header",
        "content": "Posição"
      },
      {
        "type": "setting",
        "setting_type": "radio",
        "id": "promotional_popup_image_position",
        "label": "Lado da imagem",
        "options": [
          {
            "value": "left",
            "label": "t:options.left"
          },
          {
            "value": "right",
            "label": "t:options.right"
          }
        ],
        "default": "left",
        "visible_if": "{{ settings.promotional_popup_enabled }}"
      },
      {
        "type": "setting",
        "setting_type": "text_alignment",
        "id": "promotional_popup_alignment",
        "label": "Alinhamento do texto",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "t:options.left"
          },
          {
            "value": "center",
            "label": "t:options.center"
          },
          {
            "value": "right",
            "label": "t:options.right"
          }
        ],
        "visible_if": "{{ settings.promotional_popup_enabled }}"
      }
    ]
  },
  {
    "name": "Aba do navegador",
    "settings": [
      {
        "type": "setting",
        "setting_type": "image_picker",
        "id": "cart_favicon",
        "label": "Ícone da aba quando há produtos no carrinho",
        "info": "Recomendado: 64 × 64 px, PNG."
      },
      {
        "type": "setting",
        "setting_type": "toggle",
        "id": "inactive_tab_message",
        "label": "Mostrar mensagem quando o cliente troca de aba",
        "default": true,
        "info": "O título da aba muda para chamar o cliente de volta."
      },
      {
        "type": "setting",
        "setting_type": "text",
        "id": "inactive_tab_message_01",
        "label": "Mensagem 1",
        "default": "t:defaults.inactive_tab_message_01",
        "visible_if": "{{ settings.inactive_tab_message }}",
        "info": "Ex.: Volte aqui!"
      },
      {
        "type": "setting",
        "setting_type": "text",
        "id": "inactive_tab_message_02",
        "label": "Mensagem 2",
        "default": "t:defaults.inactive_tab_message_02",
        "visible_if": "{{ settings.inactive_tab_message }}",
        "info": "Alterna com a mensagem 1."
      }
    ]
  },
  {
    "name": "Cores do checkout",
    "settings": [
      {
        "type": "paragraph",
        "content": "Cores das telas de pagamento. O checkout é da Nuvemshop: aqui só mudam as cores."
      },
      {
        "type": "setting",
        "setting_type": "color",
        "id": "checkout_header_background",
        "label": "Fundo do topo",
        "default_setting": "background_color"
      },
      {
        "type": "setting",
        "setting_type": "color",
        "id": "checkout_header_foreground",
        "label": "Texto do topo",
        "default_setting": "text_color"
      },
      {
        "type": "setting",
        "setting_type": "color",
        "id": "checkout_main_background",
        "label": "Fundo da página",
        "default_setting": "background_color"
      },
      {
        "type": "setting",
        "setting_type": "color",
        "id": "checkout_main_foreground",
        "label": "Texto da página",
        "default_setting": "text_color"
      },
      {
        "type": "setting",
        "setting_type": "color",
        "id": "checkout_accent_color",
        "label": "Cor de destaque",
        "default_setting": "accent_color",
        "info": "Links e detalhes."
      },
      {
        "type": "setting",
        "setting_type": "color",
        "id": "checkout_button_background",
        "label": "Fundo do botão principal",
        "default_setting": "button_primary_background_color"
      },
      {
        "type": "setting",
        "setting_type": "color",
        "id": "checkout_button_foreground",
        "label": "Texto do botão principal",
        "default_setting": "button_primary_foreground_color",
        "label_variants": [
          {
            "label": "t:settings.line_and_text",
            "visible_if": "{{ settings.button_primary_style == 'outline' }}"
          }
        ]
      }
    ]
  }
]
